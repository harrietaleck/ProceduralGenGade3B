# Unreal Engine .gitignore

# Build/generated folders (do NOT track)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Keep tracked: Content/, Config/, Source/, .uproject

# Visual Studio / Rider / IDE files
.vs/
.vsconfig
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled files
*.opendb

# OS files
.DS_Store
Thumbs.db

# Local editor tooling config (not part of the project)
.mcp.json
.cursor/
LaunchEditorWithMCP.bat
*.slnx

# Corrupt / retired UI packages kept locally only
Content/UI/_Deprecated/
