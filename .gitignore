# Unreal Engine .gitignore

# Build/generated folders (do NOT track)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Keep tracked: Content/, Config/, Source/, .uproject

# Visual Studio / Rider / IDE files
.vs/
.vsconfig
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled files
*.opendb

# OS files
.DS_Store
Thumbs.db

# Local editor tooling config (not part of the project)
.mcp.json
.cursor/
LaunchEditorWithMCP.bat
*.slnx

# Corrupt / retired UI packages kept locally only
Content/UI/_Deprecated/

# Accidental editor-only temp UI levels
Content/UI/Level/
Content/UI/StartScreenLvl.umap

# Python bytecode from the Docs generators
__pycache__/

# Presentation cards are for the video only and are not part of the submission
Docs/GADE7322_Part3_Presentation_Cards.*
Docs/generate_part3_presentation_cards.py
